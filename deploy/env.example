# ==============================================================================
# MosaicVPN Infrastructure Environment Variables Template
# Copy this file to .env and replace placeholders with real values.
# NEVER commit the real .env file with secrets into version control!
# ==============================================================================

# General / Remnawave Backend
APP_PORT=3000
METRICS_PORT=3001
METRICS_USER=admin
METRICS_PASS=ChangeMeToSecureMetricsPassword123!
API_INSTANCES=1
APP_HOST=0.0.0.0
HOST=0.0.0.0

# Domains
FRONT_END_DOMAIN=panel.zxc1x1.ru
SUB_PUBLIC_DOMAIN=sub.zxc1x1.ru
TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16

# Database & Cache
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourStrongPostgresPasswordHere!
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:YourStrongPostgresPasswordHere!@remnawave-db:5432/postgres?schema=public
REDIS_SOCKET=/var/run/valkey/valkey.sock

# Authentication & Security Keys
JWT_AUTH_SECRET=generate_64_char_random_hex_string_here_for_auth_secret
JWT_API_TOKENS_SECRET=generate_64_char_random_hex_string_here_for_api_tokens
JWT_AUTH_LIFETIME=7d
INTERNAL_JWT_SECRET=generate_64_char_random_hex_string_for_internal_jwt

# Remnawave API Token for Subscription page
REMNAWAVE_API_TOKEN=generate_api_token_from_remnawave_admin_panel

# Telegram Bot & Notifications
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# Mosaic Web Cabinet & Bot DB Integration (for /etc/mosaic-bot.env)
# BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example
# PG_HOST=127.0.0.1
# PG_PORT=6767
# PG_USER=postgres
# PG_PASS=YourStrongPostgresPasswordHere!
# PG_DB=postgres
