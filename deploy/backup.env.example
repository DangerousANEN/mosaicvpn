BACKUP_DIR=/var/backups/mosaic-db
BOT_DB_PATH=/opt/mosaic-bot/bot.db
AGE_RECIPIENTS_FILE=/etc/mosaic-backup.recipients
CONFIG_PATHS_FILE=/etc/mosaic-backup.paths
CONTAINER_NAME=remnawave-db
DB_USER=postgres
DB_NAME=postgres
RETENTION_DAYS=14
MAX_LOCAL_MB=1024
MIN_FREE_MB=768
# Set only AFTER Google OAuth and a successful remote write/read test.
RCLONE_REMOTE=
