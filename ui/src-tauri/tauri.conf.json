{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosaic",
  "version": "0.1.0",
  "identifier": "com.mosaicvpn.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mosaic",
        "width": 1400,
        "height": 880,
        "minWidth": 1350,
        "minHeight": 860,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      },
      {
        "label": "tray-popup",
        "url": "index.html#/tray",
        "title": "Mosaic Tray",
        "width": 360,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mosaicd",
      "binaries/sing-box"
    ],
    "resources": [
      "binaries/wintun.dll",
      "binaries/libcronet.dll"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
